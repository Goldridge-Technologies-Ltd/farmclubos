# Copy to .env and adjust. Never commit .env — see docs/guides/local-dev.md,
# which documents every variable below.

# Runtime ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3002

# Path prefix for every route except the health probes, which stay at the root
# so container and load-balancer checks need not know the prefix.
API_GLOBAL_PREFIX=api

# Comma-separated browser origins allowed to call the API directly. The webapp
# calls it server-to-server, so this is only for tooling such as Swagger.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
