# Copy to .env and adjust. Never commit .env — see docs/guides/local-dev.md,
# which documents every variable below.

# Runtime ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Path prefix for every route except the health probes, which stay at the root
# so container and load-balancer checks need not know the prefix.
API_GLOBAL_PREFIX=api

# Comma-separated browser origins allowed to call the API directly. The webapp
# calls it server-to-server, so this is only for tooling such as Swagger.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database ────────────────────────────────────────────────────────────────────
# DATABASE_URL is what the running API connects with, through the pg adapter.
# DIRECT_URL is only needed when migrations must use a different connection —
# migrations run DDL and take advisory locks, which a transaction pooler cannot
# carry. Leave it unset when the two are the same.
#
#   Supabase : take both from the project's Connect dialog. The "Session
#              pooler" row (port 5432) serves as both. The transaction pooler
#              (port 6543) is runtime-only — set DIRECT_URL to the session URL
#              if you use it.
#   Docker   : docker compose up -d postgres, then use the line below.
DATABASE_URL=postgresql://farmclub:farmclub@localhost:5432/farmclub
# DIRECT_URL=

# Connections held open by the pg pool.
DATABASE_POOL_MAX=10

# Auth ────────────────────────────────────────────────────────────────────────
# Both required, both at least 32 characters, and they must differ. Generate
# each with: openssl rand -base64 32
# JWT_ACCESS_SECRET signs access tokens. JWT_REFRESH_SECRET keys the HMAC that
# derives each rotated refresh token from the last (refresh tokens are opaque,
# not JWTs).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access tokens are verified without a database lookup, so anything they carry
# (such as the institution role) can be this many seconds stale.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# How long a just-rotated refresh token is still honoured, so concurrent
# requests are not mistaken for token theft.
REFRESH_REUSE_GRACE_SECONDS=30
PASSWORD_RESET_TTL_MINUTES=60
# How long an invitation link stays usable (hours). Defaults to seven days.
INVITE_TTL_HOURS=168

# Throttling ─────────────────────────────────────────────────────────────────
# Sign-in counts *failures* per account, so a working password costs nothing
# and someone who mistypes theirs is not locked out by reloading. A failed
# attempt also counts against the caller's address when the app forwards one,
# on a budget ten times this — an address is shared by a whole campus or
# office, and would otherwise carry all of their mistakes at once.
LOGIN_MAX_FAILURES=8
LOGIN_THROTTLE_WINDOW_SECONDS=900
# Password resets count every request, because there the request itself is the
# cost: an email in someone else's inbox.
PASSWORD_RESET_MAX_REQUESTS=5
PASSWORD_RESET_THROTTLE_WINDOW_SECONDS=3600
# Sign-ups count every request for the same reason: each one sends an email.
SIGNUP_MAX_REQUESTS=5
SIGNUP_THROTTLE_WINDOW_SECONDS=3600

# Seed only ───────────────────────────────────────────────────────────────────
# `npm run db:seed --workspace api` creates the first platform admin from these.
# The API never reads them, and the seed refuses to create an admin in
# production. An existing account keeps its password.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_FIRST_NAME=
# SEED_ADMIN_LAST_NAME=

# Mail ────────────────────────────────────────────────────────────────────────
# Links in emails point at the web app, never the API. Production refuses
# anything but its https:// address, such as https://app.example.com.
WEBAPP_URL=http://localhost:3001

# `log` writes each email, links included, to the API's console — enough to
# follow an invite in development. Production refuses it, because it would put
# invite and reset links in the logs. Use `smtp` with any provider (Resend,
# Postmark, SES), or Mailpit locally: docker compose up -d mailpit, then
# SMTP_HOST=localhost SMTP_PORT=1025 and read mail at http://localhost:8025.
MAIL_DRIVER=log
MAIL_FROM="FARMCLUB OS <no-reply@farmclubos.com>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# true for implicit TLS (usually port 465); false upgrades with STARTTLS.
# SMTP_SECURE=false

# File storage ────────────────────────────────────────────────────────────────
# Lesson videos, captions and still images. Switch with this one line:
#
#   local : a folder, api/.storage, served by this API. Needs nothing else,
#           and is the default outside production.
#   s3    : S3-compatible storage with the settings below: RustFS locally,
#           Cloudflare R2 in production, which requires s3.
STORAGE_DRIVER=local
# The local folder, relative to api/:
# STORAGE_LOCAL_DIR=.storage
# Where the browser reaches local files, when not this API on localhost, such
# as a phone on the same network (add its web app address to CORS_ORIGINS):
# STORAGE_LOCAL_PUBLIC_URL=http://192.168.1.20:4000/api/storage
#
# For s3, fill these in. They can stay while the driver is local. Then run
# this once to create the bucket and let the web app (WEBAPP_URL) upload to it
# and play from it:
#
#   npm run storage:setup --workspace api
#
#   RustFS : the values below (docker compose up -d rustfs, or the RustFS
#            binary: see docs/guides/local-dev.md).
#   R2     : STORAGE_ENDPOINT=https://<account id>.r2.cloudflarestorage.com,
#            with an R2 API token's access key id and secret.
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_BUCKET=farmclub-media
# STORAGE_ACCESS_KEY_ID=farmclub
# STORAGE_SECRET_ACCESS_KEY=farmclub-dev-secret
# R2 takes "auto"; RustFS accepts any region name.
# STORAGE_REGION=auto
