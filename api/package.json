{
  "name": "@farmclub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The FARMCLUB OS backend API.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "prebuild": "prisma generate",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "type-check": "prisma generate && tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.json",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/swagger": "12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "^8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "12.0.1",
    "@nestjs/schematics": "12.0.2",
    "@nestjs/testing": "12.0.3",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "7.2.1",
    "dotenv": "^17.4.2",
    "eslint": "9.39.5",
    "jest": "30.5.1",
    "prisma": "^7.10.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
