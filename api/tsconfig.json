{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    // DTO and config classes declare their fields without initialisers; the
    // global ValidationPipe is what guarantees they are populated.
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    // Explicit: node_modules is hoisted to the repo root, so the default would
    // make every other workspace's @types ambient in the API.
    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "test/**/*", "prisma.config.ts", "prisma/seed.ts"],
  "exclude": ["node_modules", "dist"]
}
