# Copy to .env.local and adjust. Never commit .env.local — every variable is
# documented in docs/guides/local-dev.md.

# Where the API lives: its origin only, without /api, which every request adds.
#
# Server-only on purpose, and deliberately not NEXT_PUBLIC_: the browser never
# calls the API. It talks to this app, which holds the session tokens in its
# own httpOnly cookies and calls the API server-to-server. In production this
# is the API's https:// address. On Vercel that is its public one, set in the
# project's environment variables; an internal address only works where the
# host shares a private network with the API.
API_BASE_URL=http://localhost:4000

# The commit and branch Platform → System reports for the web app. Vercel sets
# its own VERCEL_GIT_* variables on every deployment, so leave these unset
# there; set them on any other host.
# GIT_COMMIT=
# GIT_BRANCH=
