{
  "name": "@farmclub/webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-brand": "node ../packages/design-system/scripts/sync-brand.mjs",
    "predev": "npm run sync-brand",
    "dev": "next dev --turbopack --port 3001",
    "prebuild": "npm run sync-brand",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "type-check": "next typegen && tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests"
  },
  "dependencies": {
    "@farmclub/design-system": "0.1.0",
    "next": "^16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jest": "^30.5.1",
    "tailwindcss": "4.3.3",
    "ts-jest": "^29.4.12",
    "typescript": "6.0.3"
  }
}
